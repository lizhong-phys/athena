<comment>
problem   = Shearing current sheets
configure = -b --prob=rec_shear --eos=isothermal

<job>
problem_id = rec_shear         # problem ID: basename of output filenames

<output1>
file_type  = hst         # History data dump
dt         = 0.05        # time increment between outputs

#<output2>
#file_type  = vtk        # Binary data dump
#variable   = prim       # variables to be output
#dt         = 0.1        # time increment between outputs

<output3>
file_type  = hdf5       # Binary data dump
variable   = prim       # variables to be output
dt         = 0.1    # time increment between outputs

<output4>
file_type = rst
dt        = 4

<time>
cfl_number = 0.3        # The Courant, Friedrichs, & Lewy (CFL) Number
nlim       = -1         # cycle limit
tlim       = 100        # time limit (15 orbits)
integrator  = vl2       # time integration algorithm
xorder      = 2         # order of spatial reconstruction
ncycle_out  = 1         # interval for stdout summary info

<mesh>
nx1        = 32             # Number of zones in X1-direction: 128, 256
x1min      = -8             # minimum value of X1
x1max      = 8              # maximum value of X1
ix1_bc     = shear_periodic # inner-X1 boundary flag
ox1_bc     = shear_periodic # outer-X1 boundary flag

nx2        = 24        # Number of zones in X2-direction: 96, 192
x2min      = -12       # minimum value of X2
x2max      = 12        # maximum value of X2
ix2_bc     = periodic  # inner-X2 boundary flag
ox2_bc     = periodic  # outer-X2 boundary flag

nx3        = 48        # Number of zones in X3-direction: 192, 384
x3min      = -12       # minimum value of X3
x3max      = 12        # maximum value of X3
ix3_bc     = periodic  # inner-X3 boundary flag
ox3_bc     = periodic  # outer-X3 boundary flag

num_threads = 1 # maximum number of OMP threads: 32, 256

<meshblock>
nx1 = 16 # 64, 128
nx2 = 12 # 12, 24
nx3 = 12 # 12, 24

<hydro>
gamma = 1.666666666666667 # gamma = C_p/C_v
iso_sound_speed = 1.0     # isothermal sound speed
dfloor = 1e-1

<orbital_advection>
OAorder   = 2       # 0: w/o OA, 1: w/ OA (1st), 2: w/ OA (2nd)
qshear    = 1.5     # shear rate
Omega0    = 1.0     # angular velocity of the system

<problem>
eta_ohm   = 1e-3
grav      = 1.0
d0        = 1.0       # background density
amp       = 0.025     # wave amplitude
nwx       = -8        # wavenumber in x1
nwy       = 1         # wavenumber in x2
beta      = 0.1       # plasma beta
beta_mri  = 50e16     # vertical fluctuation
jwidth    = 0.03      # current sheet thickness
bx2by     = -0.10     # Bx/By
bz2bx     = 0.00      # Bz/Bx
